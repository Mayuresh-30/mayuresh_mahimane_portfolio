{
  "name": "mayuresh-ai-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "python -m uvicorn portfolio_api.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:web": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "check": "tsc --noEmit",
    "db:migrate": "alembic upgrade head",
    "db:seed": "python -m portfolio_api.seed_db"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-icons": "^14.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
